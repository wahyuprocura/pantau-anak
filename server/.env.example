# Salin ke .env lalu isi
PORT=8787

# Rahasia untuk tanda tangan JWT. WAJIB diganti dengan string acak panjang.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=ganti-dengan-string-acak-panjang

# Lokasi file database & media (relatif ke folder server, atau absolut)
DB_PATH=./data/pantau.db
MEDIA_DIR=./data/media

# Masa berlaku token ortu & lama kode pairing hidup (detik)
PARENT_TOKEN_TTL=2592000
PAIRING_CODE_TTL=300
